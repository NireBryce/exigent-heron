.gradle/
build/
*.apk
*.aab
*.ap_
*.dex
captures/
.cxx/
.kotlin/

# Generated by the Nix dev shell (flake.nix shellHook) — machine-specific.
local.properties

# Never commit signing material.
*.jks
*.keystore

# IDE
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# direnv
.direnv/

# Python bytecode — wiki/scripts/ is imported as a module by its own
# tests and by anything that reuses check_wiki.py's helpers.
__pycache__/

# Nix build result symlinks
result
result-*
